# Copy to .env and fill in. Never commit .env.
# Commented-out lines are optional; the value shown is the default.

# --- LLM (D2/D2a: agent Claude Haiku 4.5 in voice and text mode; simulated debtor Sonnet 5.5, judge Opus 5.5 in evals) ---
ANTHROPIC_API_KEY=

# --- Voice platform (D1: Vapi) ---
VAPI_PUBLIC_KEY=
VAPI_PRIVATE_KEY=
# Written here by `npm run vapi:sync` on its first run; leave it unset until then.
# VAPI_ASSISTANT_ID=
# Shared secret Vapi sends as x-vapi-secret on tool webhooks; checked only if set.
# VAPI_WEBHOOK_SECRET=
# Agent model pushed to Vapi by `npm run vapi:sync`.
# VAPI_MODEL=claude-haiku-4-5-20251001
# Vapi voice (D6).
# VAPI_VOICE_ID=Clara

# --- App ---
APP_BASE_URL=http://localhost:8000
# Public URL the voice platform can reach (e.g. an ngrok/cloudflared tunnel), if needed
PUBLIC_WEBHOOK_URL=
PORT=8000
# SQLite file for sessions and the event log.
# DB_PATH=data/app.sqlite

# --- Verification (mocked delivery) ---
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3

# --- Evals (`npm run sim`) ---
# Agent model in text mode; falls back to VAPI_MODEL, then Claude Haiku 4.5.
# AGENT_MODEL=claude-haiku-4-5-20251001
# Results folder name under evals/results/.
# SIM_LABEL=run
# Runs per persona.
# SIM_RUNS=3
# Simulated calls run in parallel.
# SIM_CONCURRENCY=8
