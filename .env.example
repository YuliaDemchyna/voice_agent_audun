# Copy to .env and fill in. Never commit .env.
# Vendor keys are added as stack decisions land (see docs/architecture.md).

# --- LLM (D2: agent Sonnet 5.5, simulator Sonnet 5.5, judge Opus 5.5; used by text mode and evals) ---
ANTHROPIC_API_KEY=

# --- Voice platform (D1: Vapi) ---
VAPI_PUBLIC_KEY=
VAPI_PRIVATE_KEY=

# --- App ---
APP_BASE_URL=http://localhost:8000
# Public URL the voice platform can reach (e.g. an ngrok/cloudflared tunnel), if needed
PUBLIC_WEBHOOK_URL=
PORT=8000

# --- Verification (mocked delivery) ---
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3
