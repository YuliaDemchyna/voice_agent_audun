{
  "name": "audun-voice-agent",
  "version": "1.0.0",
  "description": "Debt-collection voice agent prototype (Audun take-home)",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "vitest run",
    "dev": "tsx watch backend/api/server.ts",
    "start": "tsx backend/api/server.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "vapi:sync": "tsx agent/sync-vapi.ts",
    "sim": "tsx evals/harness/simulate.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YuliaDemchyna/voice_agent_audun.git"
  },
  "bugs": {
    "url": "https://github.com/YuliaDemchyna/voice_agent_audun/issues"
  },
